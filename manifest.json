{
  "manifest_version": 3,
  "name": "Agent Buttons for GitHub",
  "version": "0.3.0",
  "description": "Adds T3 Code, Cursor and copy-prompt buttons to GitHub pull request review comments.",
  "icons": {
    "16": "icons/ext-16.png",
    "48": "icons/ext-48.png",
    "128": "icons/ext-128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/prompt.js",
        "src/github-page.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/t3code.png",
        "icons/cursor.png"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
